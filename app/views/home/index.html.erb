<main class="page-shell">
  <section class="hero">
    <p class="eyebrow">Pokemon of the Day</p>
    <h1>Daily and hourly featured Pokemon</h1>
    <p class="hero__date">Date: <%= formatted_date(@featured_date) %></p>
  </section>

  <%= render "pokemon_feature",
    eyebrow: "Pokemon of the Day",
    title: "Today's featured Pokemon",
    subtitle: "Date: #{formatted_date(@featured_date)}",
    pokemon: @featured_pokemon,
    error_message: @featured_error_message %>

  <%= render "pokemon_feature",
    eyebrow: "Pokemon of the Hour",
    title: "This hour's featured Pokemon",
    subtitle: "Hour: #{formatted_hour(@reference_time)}",
    pokemon: @hourly_pokemon,
    error_message: @hourly_error_message %>
</main>
